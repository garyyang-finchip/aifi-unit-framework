pragma solidity ^0.8.20;

import "forge-std/Test.sol";
import {AUFUnitRegistry} from "auf/AUFUnitRegistry.sol";
import {AUFAssertionRegistry} from "auf/AUFAssertionRegistry.sol";
import {IAUFUnitRegistry} from "auf/interfaces/IAUFUnitRegistry.sol";
import {IAUFAssertionRegistry} from "auf/interfaces/IAUFAssertionRegistry.sol";
import {AUFValuationLib} from "auf/libraries/AUFValuationLib.sol";
import {UnitRef, AssertionInput, AssertionKind, ValuationCore, AUFResultKind} from "auf/AUFTypes.sol";

/// @notice Cross-checks the JSON vectors generated by tools/vectors.js (ethers) against the Solidity side.
contract VectorsTest is Test {
    string internal constant DIR = "assets/erc-auf/vectors/";

    function _json(string memory file) internal view returns (string memory) {
        return vm.readFile(string.concat(DIR, file));
    }

    // ------------------------------------------------------------ interface ids

    function testInterfaceIds() public view {
        string memory j = _json("interface-ids.json");
        assertEq(bytes4(vm.parseJsonBytes(j, ".IAUFUnitRegistry")), type(IAUFUnitRegistry).interfaceId);
        assertEq(bytes4(vm.parseJsonBytes(j, ".IAUFAssertionRegistry")), type(IAUFAssertionRegistry).interfaceId);
    }

    // ------------------------------------------------------------ identifiers

    function testProfileAndElementIdentifiers() public view {
        string memory j = _json("identifiers.json");
        assertEq(vm.parseJsonBytes32(j, ".profileIds[\"auf:role:source@1\"]"), keccak256("auf:role:source@1"));
        assertEq(vm.parseJsonBytes32(j, ".profileIds[\"auf:interest:net-equity@1\"]"), keccak256("auf:interest:net-equity@1"));
        assertEq(vm.parseJsonBytes32(j, ".descriptorKinds[\"auf:method\"]"), keccak256("auf:method"));
        assertEq(vm.parseJsonBytes32(j, ".denominationIds.USD"), keccak256("USD"));
        string memory kind = vm.parseJsonString(j, ".elementIdExample.kind");
        string memory ref = vm.parseJsonString(j, ".elementIdExample.ref");
        assertEq(vm.parseJsonBytes32(j, ".elementIdExample.elementId"), keccak256(abi.encodePacked(kind, ":", ref)));
        assertEq(
            keccak256(abi.encodePacked(kind, ":", ref)),
            keccak256("skill:eip155:11155111/erc721:0x00000000000000000000000000000000000000aa/1")
        );
    }

    // ------------------------------------------------------------ canonicalization

    function testCanonicalizationVector() public view {
        string memory j = _json("canonicalization.json");
        string memory canonical = vm.parseJsonString(j, ".canonical");
        assertEq(keccak256(bytes(canonical)), vm.parseJsonBytes32(j, ".boundaryHash"));
        assertEq(
            canonical,
            "{\"auf\":\"1.0\",\"authorities\":{\"definitionController\":\"none\"},\"elements\":[],\"kind\":\"unit-definition\",\"ports\":[],\"relations\":[],\"unit\":{\"name\":\"Vector Unit\"}}"
        );
    }

    // ------------------------------------------------------------ valuation vectors (bit-exact)

    function testNetEquityVectorBitExact() public view {
        string memory j = _json("valuation-vectors.json");
        int256[] memory assets = new int256[](1);
        assets[0] = vm.parseJsonInt(j, ".vectors[0].fixedPoint.assetsWad[0]");
        int256[] memory liabilities = new int256[](1);
        liabilities[0] = vm.parseJsonInt(j, ".vectors[0].fixedPoint.liabilitiesWad[0]");
        assertEq(AUFValuationLib.netEquity(assets, liabilities), vm.parseJsonInt(j, ".vectors[0].expected.valueWad"));
    }

    function testRealizedNetCashFlowVectorBitExact() public view {
        string memory j = _json("valuation-vectors.json");
        uint256[] memory inflows = new uint256[](1);
        inflows[0] = vm.parseJsonUint(j, ".vectors[1].fixedPoint.inflowsWad[0]");
        uint256[] memory outflows = new uint256[](2);
        outflows[0] = vm.parseJsonUint(j, ".vectors[1].fixedPoint.outflowsWad[0]");
        outflows[1] = vm.parseJsonUint(j, ".vectors[1].fixedPoint.outflowsWad[1]");
        assertEq(AUFValuationLib.realizedNetCashFlow(inflows, outflows), vm.parseJsonInt(j, ".vectors[1].expected.valueWad"));
    }

    function testFiniteHorizonDCFVectorBitExact() public view {
        string memory j = _json("valuation-vectors.json");
        int256[] memory cf = new int256[](2);
        cf[0] = vm.parseJsonInt(j, ".vectors[2].fixedPoint.cashflowsWad[0]");
        cf[1] = vm.parseJsonInt(j, ".vectors[2].fixedPoint.cashflowsWad[1]");
        uint256 rate = vm.parseJsonUint(j, ".vectors[2].fixedPoint.rateWad");
        int256 tv = vm.parseJsonInt(j, ".vectors[2].fixedPoint.terminalValueWad");
        assertEq(AUFValuationLib.finiteHorizonDCF(cf, rate, tv), vm.parseJsonInt(j, ".vectors[2].expected.valueWad"));
    }

    function _conditional(string memory j, uint256 index) internal pure returns (int256) {
        string memory base = string.concat(".vectors[", vm.toString(index), "].fixedPoint");
        int256[] memory payoffs = new int256[](2);
        payoffs[0] = vm.parseJsonInt(j, string.concat(base, ".payoffsWad[0]"));
        payoffs[1] = vm.parseJsonInt(j, string.concat(base, ".payoffsWad[1]"));
        uint256[] memory probs = new uint256[](2);
        probs[0] = vm.parseJsonUint(j, string.concat(base, ".probabilitiesWad[0]"));
        probs[1] = vm.parseJsonUint(j, string.concat(base, ".probabilitiesWad[1]"));
        uint256 rate = vm.parseJsonUint(j, string.concat(base, ".rateWad"));
        uint256 periods = vm.parseJsonUint(j, string.concat(base, ".periods"));
        return AUFValuationLib.conditionalPayoff(payoffs, probs, rate, periods);
    }

    function testConditionalPayoffVectorsBitExact() public view {
        string memory j = _json("valuation-vectors.json");
        assertEq(_conditional(j, 3), vm.parseJsonInt(j, ".vectors[3].expected.valueWad"));
        int256 obligation = _conditional(j, 4);
        assertEq(obligation, vm.parseJsonInt(j, ".vectors[4].expected.valueWad"));
        assertLt(obligation, 0);
    }

    // ------------------------------------------------------------ EIP-712

    function _readInput(string memory j) internal pure returns (AssertionInput memory input) {
        input.kind = AssertionKind(uint8(vm.parseJsonUint(j, ".input.kind")));
        input.unitId = vm.parseJsonUint(j, ".input.unitId");
        input.version = uint32(vm.parseJsonUint(j, ".input.version"));
        input.profileId = vm.parseJsonBytes32(j, ".input.profileId");
        input.contentHash = vm.parseJsonBytes32(j, ".input.contentHash");
        input.contentURI = vm.parseJsonString(j, ".input.contentURI");
        input.validFrom = uint64(vm.parseJsonUint(j, ".input.validFrom"));
        input.validUntil = uint64(vm.parseJsonUint(j, ".input.validUntil"));
        input.supersedes = vm.parseJsonBytes32(j, ".input.supersedes");
        input.payload = vm.parseJsonBytes(j, ".payload");
    }

    function testEIP712StructHashVector() public {
        string memory j = _json("eip712.json");
        AUFUnitRegistry units = new AUFUnitRegistry();
        AUFAssertionRegistry reg = new AUFAssertionRegistry(units);
        assertEq(vm.parseJsonBytes32(j, ".typeHash"), reg.ASSERTION_TYPEHASH());

        AssertionInput memory input = _readInput(j);
        // payload decodes to the documented ValuationCore
        ValuationCore memory core = abi.decode(input.payload, (ValuationCore));
        assertEq(core.value, vm.parseJsonInt(j, ".valuationCore.value"));
        assertEq(core.resultKind, AUFResultKind.MONETARY);
        assertEq(keccak256(input.payload), vm.parseJsonBytes32(j, ".input.payloadHash"));
        // struct hash agrees with ethers' TypedDataEncoder
        uint256 nonce = vm.parseJsonUint(j, ".input.nonce");
        uint256 deadline = vm.parseJsonUint(j, ".input.deadline");
        assertEq(reg.structHashOf(input, nonce, deadline), vm.parseJsonBytes32(j, ".structHash"));
    }

    function testEIP712ExampleSignatureVector() public view {
        string memory j = _json("eip712.json");
        bytes32 exampleSeparator = vm.parseJsonBytes32(j, ".exampleDomainSeparator");
        bytes32 structHash = vm.parseJsonBytes32(j, ".structHash");
        bytes32 digest = keccak256(abi.encodePacked("\x19\x01", exampleSeparator, structHash));
        assertEq(digest, vm.parseJsonBytes32(j, ".exampleDigest"));
        (bytes32 r, bytes32 s, uint8 v) = _split(vm.parseJsonBytes(j, ".exampleSignature"));
        address recovered = ecrecover(digest, v, r, s);
        assertEq(recovered, vm.parseJsonAddress(j, ".exampleSigner"));
    }

    function _split(bytes memory sig) internal pure returns (bytes32 r, bytes32 s, uint8 v) {
        require(sig.length == 65, "sig");
        assembly {
            r := mload(add(sig, 32))
            s := mload(add(sig, 64))
            v := byte(0, mload(add(sig, 96)))
        }
    }

    // ------------------------------------------------------------ examples: registration order and containment

    function testExamplesRegisterInPlannedOrder() public {
        string memory j = _json("examples.json");
        AUFUnitRegistry units = new AUFUnitRegistry();
        UnitRef[] memory none;
        uint256 n = 7;
        for (uint256 i = 0; i < n; i++) {
            string memory base = string.concat(".units[", vm.toString(i), "]");
            uint256 plannedId = vm.parseJsonUint(j, string.concat(base, ".unitId"));
            bytes32 h = vm.parseJsonBytes32(j, string.concat(base, ".boundaryHash"));
            address controller = vm.parseJsonAddress(j, string.concat(base, ".controller"));
            string memory file = vm.parseJsonString(j, string.concat(base, ".file"));
            // contains: read as an array of {unitId, version}
            bytes memory raw = vm.parseJson(j, string.concat(base, ".contains"));
            UnitRef[] memory refs = none;
            if (plannedId == 4) {
                refs = new UnitRef[](2);
                refs[0] = UnitRef(vm.parseJsonUint(j, string.concat(base, ".contains[0].unitId")), uint32(vm.parseJsonUint(j, string.concat(base, ".contains[0].version"))));
                refs[1] = UnitRef(vm.parseJsonUint(j, string.concat(base, ".contains[1].unitId")), uint32(vm.parseJsonUint(j, string.concat(base, ".contains[1].version"))));
            } else {
                assertEq(raw.length, 64, "unexpected contains entries"); // abi-encoded empty array
            }
            uint256 id = units.registerUnit(controller, h, file, refs);
            assertEq(id, plannedId);
        }
        // swarm (4) contains sub-units 2 and 3 at version 1
        (,,, uint256 c) = units.versionOf(4, 1);
        assertEq(c, 2);
        assertEq(units.containedAt(4, 1, 0).unitId, 2);
        assertEq(units.containedAt(4, 1, 1).unitId, 3);
        assertEq(units.controllerOf(4), vm.parseJsonAddress(j, ".units[3].controller"));
    }

    // ------------------------------------------------------------ exception vector: boundary change

    function testBoundaryChangeSeparatesReceipts() public {
        AUFUnitRegistry units = new AUFUnitRegistry();
        AUFAssertionRegistry reg = new AUFAssertionRegistry(units);
        UnitRef[] memory none;
        address controller = makeAddr("controller");
        units.registerUnit(controller, keccak256("v1"), "v1", none);

        bytes32 methodId = keccak256("method");
        ValuationCore memory core = ValuationCore({
            methodId: methodId,
            interestId: keccak256("auf:interest:net-equity@1"),
            assessmentBoundaryHash: keccak256("v1"),
            snapshotHash: keccak256("snap"),
            resultKind: AUFResultKind.MONETARY,
            decimals: 2,
            value: 7000,
            denominationId: keccak256("USD"),
            asOf: 1_700_000_000,
            horizonEnd: 0
        });
        AssertionInput memory a;
        a.kind = AssertionKind.Valuation;
        a.unitId = 1;
        a.version = 1;
        a.profileId = methodId;
        a.contentHash = keccak256("receipt");
        a.contentURI = "ipfs://receipt";
        a.payload = abi.encode(core);
        reg.assertStatement(a);

        // the Unit publishes version 2 (one element added): the receipt stays with version 1
        vm.prank(controller);
        units.publishVersion(1, keccak256("v2"), "v2", none);
        assertEq(reg.assertionCount(1, 1), 1);
        assertEq(reg.assertionCount(1, 2), 0);
    }
}
